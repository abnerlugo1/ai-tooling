# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_FALLBACK_ORDER=openai
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=500
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=your_openai_api_key_here

# Voice Agent Feature Flags
VOICE_ENABLED=true
VOICE_MODE=realtime
VOICE_INPUT_ENABLED=true
VOICE_OUTPUT_ENABLED=true
VOICE_REALTIME_BROWSER_ENABLED=true
VOICE_REALTIME_TTS_ENABLED=true
VOICE_REALTIME_BARGE_IN_ENABLED=true
VOICE_INTERMEDIATE_MESSAGE_ENABLED=true
VOICE_INTERMEDIATE_MESSAGE_DELAY_SECONDS=4.0
VOICE_INTERMEDIATE_MESSAGE_TEXT=Revisando información...
ANALYTICS_VISUALS_ENABLED=true

# Security & Authentication (HTTP Basic Auth)
CHATBOT_AUTH_ENABLED=true
CHATBOT_AUTH_USER=admin
CHATBOT_AUTH_PASSWORD=change_this_secure_password_2026
